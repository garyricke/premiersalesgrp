---
import Base from '../layouts/Base.astro';
import { SITE, PERSON, MEDIA, cld } from '../consts';

const facts = [
  { k: 'Runtime', v: '~75 sec (with :30 and :15 cut-downs)' },
  { k: 'Format', v: 'Cinematic brand documentary' },
  { k: 'Location', v: 'The Unified Wire & Cable factory floor' },
  { k: 'Tone', v: 'Warm, honest, a little nostalgic' },
];

// Each scene is a beat in the storyboard.
const scenes = [
  {
    t: '0:00 – 0:06',
    tag: 'Cold open',
    type: 'img',
    src: cld(MEDIA.heroCable, 'w_900'),
    onscreen: 'Extreme macro — copper strands catch the light as a massive spool turns, almost imperceptibly.',
    vo: '',
    note: 'SFX only: a low industrial hum and a single warm piano note.',
  },
  {
    t: '0:06 – 0:15',
    tag: 'The reveal',
    type: 'img',
    src: cld(MEDIA.storySpool, 'w_900'),
    onscreen: 'Slow pull-back reveals Jason seated in front of the spool, lit warm. He looks to camera and begins.',
    vo: 'I didn’t choose the wire business. I was kind of born into it.',
    note: 'The signature hero shot — this frame becomes the home-page video poster.',
  },
  {
    t: '0:15 – 0:27',
    tag: 'The grandfather',
    type: 'img',
    src: cld(MEDIA.storyArchival, 'w_900'),
    onscreen: 'Cut to a faded photograph: Jason’s grandfather on the factory floor.',
    vo: 'My grandfather started this. It was his life’s work — long before it was mine.',
    note: 'Concept placeholder. Jason supplies the real family photo.',
  },
  {
    t: '0:27 – 0:39',
    tag: 'The father',
    type: 'placeholder',
    label: 'Dad on the floor',
    onscreen: 'Another archival photo: Jason’s dad running the floor — machines, spools, motion.',
    vo: 'My dad ran it. I grew up walking these floors — the sound of the machines, spools taller than I was.',
    note: 'Jason supplies the real photo.',
  },
  {
    t: '0:39 – 0:49',
    tag: 'Young Jason',
    type: 'placeholder',
    label: 'Young Jason, with wire',
    onscreen: 'A snapshot of a young Jason in the factory — maybe holding a piece of wire, grinning.',
    vo: 'I was the kid in the corner. Now I get to carry it forward.',
    note: 'Jason supplies the real photo.',
  },
  {
    t: '0:49 – 0:59',
    tag: 'The craft',
    type: 'img',
    src: cld(MEDIA.storyBroll, 'w_900'),
    onscreen: 'Macro b-roll: a hand runs along taut copper, machines spool, warm light flares.',
    vo: 'Wire isn’t glamorous. But done right, it’s everything that holds a build together.',
    note: '',
  },
  {
    t: '0:59 – 1:10',
    tag: 'The turn',
    type: 'img',
    src: cld(MEDIA.storySpool, 'w_900,e_brightness:-8'),
    onscreen: 'Back to Jason at the spool, direct to camera, confident and easy.',
    vo: 'That’s why I started Premier Sales Group — the same family product, a faster and more personal way to do business.',
    note: '',
  },
  {
    t: '1:10 – 1:16',
    tag: 'The line',
    type: 'slogan',
    onscreen: 'Hold on Jason. A beat. He half-smiles.',
    vo: SITE.slogan,
    note: 'The emotional button — and the brand tagline.',
  },
  {
    t: '1:16 – 1:24',
    tag: 'Close / CTA',
    type: 'logo',
    onscreen: 'Peak logo resolves over black with a soft copper shimmer; contact details fade up.',
    vo: '',
    note: `On screen: Premier Sales Group · premiersalesgrp.com · ${PERSON.phoneDisplay}`,
  },
];

const wishlist = [
  { who: 'Grandfather', items: 'Any photos at or around the factory, portraits, with product or machinery, old IDs or news clippings.' },
  { who: 'Dad', items: 'On the factory floor, running machines, portraits, with the team, anything candid.' },
  { who: 'Young Jason', items: 'In the factory, holding wire or spools, family-at-work moments, school-age through today.' },
  { who: 'The company', items: 'Vintage factory exterior/interior, old equipment, original logos / letterhead / catalogs, product shots.' },
  { who: 'Anything with wire', items: 'Spools, reels, copper, machines — even blurry, faded, or damaged photos are gold. Scan at the highest resolution possible.' },
];

const production = [
  { h: 'The set', p: 'Shoot at the real factory. Pull the largest copper spool available as the hero backdrop. Jason on a stool, relaxed — no podium, no script in hand.' },
  { h: 'Light & camera', p: 'Single warm key with a copper rim light and deep negative space. Shallow depth of field, a few slow push-ins, a macro lens for b-roll.' },
  { h: 'Wardrobe', p: 'Keep it him — a clean polo or quarter-zip. Authentic beats corporate. This is a blue-collar trade; dress like it.' },
  { h: 'Audio', p: 'Lav mic on Jason, controlled floor noise, and a minimal warm piano/strings bed. Record room tone for the edit.' },
  { h: 'Captions', p: 'Burn in subtitles — most people watch muted, especially from a QR scan on their phone.' },
  { h: 'Delivery', p: 'Master in 4K. Export a 75s hero cut, a :30 social cut, and a :15 teaser for ads and the postcard QR.' },
];
---

<Base
  title="Video Concept — Three Generations of Wire"
  description="Storyboard for the Premier Sales Group brand film: Jason Foley tells the story of growing up in his family's wire business, in front of a giant spool of copper."
  path="/video-concept"
  noindex={true}
>
  <!-- Hero -->
  <section class="section vc-hero">
    <div class="wrap">
      <p class="eyebrow">Video Concept · Brand Film</p>
      <h1 class="vc-title">Three generations.<br />One spool of copper.<br /><span class="serif-accent text-copper">One story.</span></h1>
      <p class="vc-lede">
        The hero film for the home page: Jason, seated in front of a towering spool of copper
        wire on the factory floor, telling the true story of how he grew up in the family wire
        business — his grandfather, his father, and the trade in his blood. Woven with real
        archival family photos. It ends on the line the whole brand is built around:
        <strong class="text-copper">“{SITE.slogan}”</strong>
      </p>
      <div class="vc-facts">
        {facts.map((f) => (
          <div class="vc-fact"><span class="mono">{f.k}</span><strong>{f.v}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Poster preview -->
  <section class="section--line">
    <div class="wrap">
      <figure class="vc-poster" style={`background-image:linear-gradient(90deg, rgba(11,15,20,0.85) 5%, rgba(11,15,20,0.25) 45%, transparent 75%), url('${cld(MEDIA.storySpool, 'w_1600')}')`}>
        <div class="vc-poster__inner">
          <button class="vc-play" aria-label="Play (concept)">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <p class="mono vc-poster__label">Concept poster frame · ~75 sec</p>
          <p class="vc-poster__line serif-accent">“{SITE.slogan}”</p>
        </div>
      </figure>
    </div>
  </section>

  <!-- Storyboard -->
  <section class="section section--line">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The Storyboard</p>
        <h2>Shot by shot.</h2>
        <p>Nine beats, about seventy-five seconds. Voiceover is Jason’s — loose and real, not read.</p>
      </div>

      <ol class="board">
        {scenes.map((s, i) => (
          <li class="scene">
            <div class="scene__frame">
              {s.type === 'img' && <img src={s.src} alt={s.onscreen} width="900" height="506" loading="lazy" />}
              {s.type === 'placeholder' && (
                <div class="frame-ph">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span class="mono">{s.label}</span>
                  <span class="frame-ph__tag">Jason’s archive photo</span>
                </div>
              )}
              {s.type === 'slogan' && <div class="frame-slogan"><span class="serif-accent">“{s.vo}”</span></div>}
              {s.type === 'logo' && (
                <div class="frame-logo">
                  <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M5 35 L24 11 L43 35" fill="none" stroke="#c8772e" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 37 L24 23 L35 37" fill="none" stroke="#e0903f" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/><circle cx="24" cy="40.5" r="2.4" fill="#e0903f"/></svg>
                  <b>Premier Sales Group</b>
                </div>
              )}
              <span class="scene__no mono">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="scene__body">
              <div class="scene__meta">
                <span class="tag">{s.tag}</span>
                <span class="mono scene__t">{s.t}</span>
              </div>
              <p class="scene__on">{s.onscreen}</p>
              {s.vo && <p class="scene__vo"><span class="mono">VO</span>“{s.vo}”</p>}
              {s.note && <p class="scene__note mono">{s.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Photo wishlist -->
  <section class="section section--line">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What Jason Brings</p>
        <h2>The archive hunt.</h2>
        <p>The film lives or dies on the old photos. The more, the better — we’ll restore and color-grade them to fit.</p>
      </div>
      <div class="wish">
        {wishlist.map((w) => (
          <div class="wish__row">
            <span class="wish__who">{w.who}</span>
            <p class="wish__items">{w.items}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Production -->
  <section class="section section--line">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Production Notes</p>
        <h2>How we shoot it.</h2>
      </div>
      <div class="prod">
        {production.map((p) => (
          <div class="card prod__card">
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Distribution -->
  <section class="section section--line">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Where It Lives</p>
        <h2>From the home page to the palm of their hand.</h2>
        <p>One film, working everywhere — the centerpiece of the site and the payoff of every QR scan.</p>
      </div>
      <div class="dist">
        <div class="dist__flow">
          <div class="dist__step"><span class="dist__icon">▣</span><b>QR code</b><span>On the business card, postcard, and email signature.</span></div>
          <span class="dist__arrow" aria-hidden="true">→</span>
          <div class="dist__step"><span class="dist__icon">⌂</span><b>premiersalesgrp.com</b><span>Lands on the home page, video front and center.</span></div>
          <span class="dist__arrow" aria-hidden="true">→</span>
          <div class="dist__step"><span class="dist__icon">▶</span><b>They watch the story</b><span>90 seconds later, they know exactly who Jason is.</span></div>
        </div>
        <div class="dist__cards">
          <div class="card"><h3>Home page hero</h3><p>The film becomes the centerpiece of the landing page — click-to-play over the copper hero, with the poster frame above.</p></div>
          <div class="card"><h3>The QR payoff</h3><p>Every printed touchpoint carries a QR straight to the film. A buyer who scans it meets Jason before they ever pick up the phone.</p></div>
          <div class="card"><h3>Cut-downs</h3><p>A :30 for LinkedIn and a :15 teaser for ads and the postcard — same story, built to stop the scroll.</p></div>
        </div>
      </div>
      <div class="vc-cta">
        <p class="serif-accent vc-cta__line">“{SITE.slogan}”</p>
        <a href="/print-assets#postcard" class="btn">See where the QR goes</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .vc-hero { padding-top: clamp(3rem, 8vw, 6rem); }
  .vc-title { font-size: var(--step-4); margin: 1.4rem 0; font-weight: 400; }
  .vc-lede { max-width: 64ch; color: var(--text-dim); font-size: var(--step-1); }
  .vc-lede strong { font-weight: 500; }
  .vc-facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin-top: 2.5rem; }
  .vc-fact { background: var(--charcoal); padding: 1rem 1.3rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .vc-fact strong { font-family: var(--font-grotesk); font-size: 0.92rem; color: var(--bone); font-weight: 600; }
  @media (max-width: 760px) { .vc-facts { grid-template-columns: 1fr 1fr; } }

  /* poster */
  .vc-poster { aspect-ratio: 21 / 9; border-radius: var(--radius-lg); overflow: hidden; background-size: cover; background-position: center; border: 1px solid var(--line); display: flex; align-items: flex-end; box-shadow: 0 40px 80px -40px rgba(0,0,0,0.8); }
  .vc-poster__inner { padding: clamp(1.4rem, 4vw, 3rem); }
  .vc-play { width: clamp(56px, 8vw, 78px); height: clamp(56px, 8vw, 78px); border-radius: 50%; border: 0; background: var(--copper); color: var(--ink); display: grid; place-items: center; transition: transform 0.25s var(--ease), background 0.25s var(--ease); box-shadow: 0 16px 40px -16px rgba(200,119,46,0.8); }
  .vc-play:hover { transform: scale(1.07); background: var(--copper-bright); }
  .vc-play svg { width: 42%; height: 42%; margin-left: 8%; }
  .vc-poster__label { color: var(--bone-dim); margin-top: 1rem; }
  .vc-poster__line { font-size: clamp(1.3rem, 3.5vw, 2.1rem); color: var(--bone); margin-top: 0.3rem; }

  /* storyboard */
  .board { display: flex; flex-direction: column; gap: 1rem; counter-reset: none; }
  .scene { display: grid; grid-template-columns: 340px 1fr; gap: clamp(1rem, 3vw, 2rem); align-items: stretch; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1rem; background: linear-gradient(180deg, rgba(244,241,236,0.02), transparent); }
  .scene__frame { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--ink); border: 1px solid var(--line); }
  .scene__frame img { width: 100%; height: 100%; object-fit: cover; }
  .scene__no { position: absolute; left: 0.6rem; top: 0.5rem; background: rgba(11,15,20,0.75); color: var(--copper-bright); padding: 0.2em 0.55em; border-radius: 4px; font-size: 0.72rem; }
  .frame-ph { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; color: var(--text-mute); background: repeating-linear-gradient(45deg, rgba(244,241,236,0.02) 0 10px, transparent 10px 20px); }
  .frame-ph svg { width: 2rem; height: 2rem; color: var(--copper-deep); }
  .frame-ph__tag { font-family: var(--font-grotesk); font-weight: 700; font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--copper-bright); }
  .frame-slogan { width: 100%; height: 100%; display: grid; place-items: center; padding: 1rem; text-align: center; background: radial-gradient(circle at 50% 40%, rgba(200,119,46,0.18), transparent 70%); }
  .frame-slogan .serif-accent { font-size: clamp(1.1rem, 3vw, 1.6rem); color: var(--bone); }
  .frame-logo { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem; background: var(--ink); }
  .frame-logo svg { width: 2.6rem; height: 2.6rem; }
  .frame-logo b { font-family: var(--font-grotesk); font-size: 0.78rem; color: var(--bone); letter-spacing: 0.02em; }

  .scene__body { padding: 0.4rem 0.6rem; display: flex; flex-direction: column; }
  .scene__meta { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.8rem; }
  .scene__t { color: var(--text-mute); font-size: 0.72rem; }
  .scene__on { color: var(--text); }
  .scene__vo { margin-top: 0.8rem; font-family: var(--font-display); font-style: italic; color: var(--copper-bright); font-size: 1.05rem; display: flex; gap: 0.6rem; align-items: baseline; }
  .scene__vo .mono { font-style: normal; color: var(--text-mute); font-size: 0.62rem; letter-spacing: 0.1em; flex: none; padding-top: 0.2rem; }
  .scene__note { color: var(--text-mute); margin-top: auto; padding-top: 0.8rem; font-size: 0.72rem; }
  @media (max-width: 680px) { .scene { grid-template-columns: 1fr; } }

  /* wishlist */
  .wish { display: flex; flex-direction: column; }
  .wish__row { display: grid; grid-template-columns: 170px 1fr; gap: 1.5rem; padding: 1.2rem 0; border-top: 1px solid var(--line); }
  .wish__row:last-child { border-bottom: 1px solid var(--line); }
  .wish__who { font-family: var(--font-display); font-size: 1.2rem; color: var(--bone); }
  .wish__items { color: var(--text-dim); }
  @media (max-width: 620px) { .wish__row { grid-template-columns: 1fr; gap: 0.4rem; } }

  /* production */
  .prod { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .prod__card h3 { font-size: var(--step-1); margin-bottom: 0.6rem; }
  .prod__card p { color: var(--text-dim); font-size: 0.95rem; }
  @media (max-width: 820px) { .prod { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .prod { grid-template-columns: 1fr; } }

  /* distribution */
  .dist__flow { display: flex; align-items: stretch; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .dist__step { flex: 1; min-width: 180px; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.4rem; display: flex; flex-direction: column; gap: 0.4rem; background: var(--charcoal-2); }
  .dist__icon { font-size: 1.4rem; color: var(--copper-bright); }
  .dist__step b { font-family: var(--font-grotesk); color: var(--bone); }
  .dist__step span:last-child { color: var(--text-dim); font-size: 0.9rem; }
  .dist__arrow { align-self: center; color: var(--copper); font-size: 1.5rem; }
  .dist__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .dist__cards h3 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .dist__cards p { color: var(--text-dim); font-size: 0.95rem; }
  @media (max-width: 820px) { .dist__cards { grid-template-columns: 1fr; } .dist__arrow { display: none; } }

  .vc-cta { text-align: center; margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .vc-cta__line { font-size: clamp(1.6rem, 5vw, 2.6rem); color: var(--bone); margin-bottom: 1.5rem; }
</style>
