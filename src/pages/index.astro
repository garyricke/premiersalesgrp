---
import Base from '../layouts/Base.astro';
import Signature from '../components/Signature.astro';
import { SITE, PERSON, LINES, APPROACH, FAQS, MEDIA, cld } from '../consts';

const unified = LINES[0];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: PERSON.phone,
  email: PERSON.email,
  foundingDate: SITE.founded,
  image: cld(MEDIA.heroCable, 'w_1200'),
  areaServed: { '@type': 'Country', name: 'United States' },
  knowsAbout: [
    'Electrical wire and cable',
    'THHN building wire',
    'Manufacturers representation',
    'Wire and cable sourcing',
  ],
  founder: {
    '@type': 'Person',
    name: PERSON.name,
    jobTitle: PERSON.role,
  },
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Wire & cable manufacturers’ representation',
      provider: { '@id': `${SITE.url}/#organization` },
    },
  },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#jason-foley`,
  name: PERSON.name,
  jobTitle: PERSON.title,
  telephone: PERSON.phone,
  email: PERSON.email,
  image: cld(MEDIA.headshot, 'w_800'),
  worksFor: { '@id': `${SITE.url}/#organization` },
  sameAs: [PERSON.linkedin],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  publisher: { '@id': `${SITE.url}/#organization` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const stats = [
  { n: '3', label: 'Generations of wire & cable lineage' },
  { n: '100+', label: 'Accounts under management' },
  { n: '1', label: 'Carefully chosen line — and growing' },
  { n: '24 hr', label: 'Typical quote turnaround' },
];
---

<Base
  title={`${SITE.name} — Wire & Cable Representation by Jason Foley`}
  description={SITE.description}
  path="/"
  schema={[orgSchema, personSchema, websiteSchema, faqSchema]}
>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img
        src={cld(MEDIA.heroCable, 'w_1600')}
        srcset={`${cld(MEDIA.heroCable, 'w_900')} 900w, ${cld(MEDIA.heroCable, 'w_1600')} 1600w, ${cld(MEDIA.heroCable, 'w_2200')} 2200w`}
        sizes="100vw"
        alt=""
        width="1600" height="900"
        fetchpriority="high"
      />
      <div class="hero__scrim"></div>
    </div>

    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow">Manufacturers’ Representative · Wire &amp; Cable</p>
      <h1 class="hero__title">
        The trusted link between American wire makers
        <span class="serif-accent text-copper">&amp; the buyers</span> who need them.
      </h1>
      <p class="hero__slogan serif-accent">“{SITE.slogan}”</p>
      <p class="hero__lede">
        Premier Sales Group is the independent rep firm of <strong>{PERSON.name}</strong> —
        representing <a href={unified.site} target="_blank" rel="noopener" class="hero__ul">Unified Wire &amp; Cable</a>,
        quoting sharp, and making it easy to bring your business back home.
      </p>
      <div class="hero__cta">
        <a href="#contact" class="btn">
          Request a Quote
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#lines" class="btn btn--ghost">See the Line</a>
      </div>
      <p class="hero__meta mono">Representing Unified Wire &amp; Cable · Serving accounts nationwide</p>
    </div>
  </section>

  <!-- ============================ STATS ============================ -->
  <section class="section--line">
    <div class="wrap stats">
      {stats.map((s) => (
        <div class="stat reveal">
          <span class="stat__n">{s.n}</span>
          <span class="stat__l">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================ ABOUT ============================ -->
  <section class="section section--line" id="about">
    <div class="wrap about">
      <div class="about__media reveal">
        <img
          src={cld(MEDIA.headshot, 'w_720,c_fill,ar_4:5,g_face')}
          srcset={`${cld(MEDIA.headshot, 'w_560,c_fill,ar_4:5,g_face')} 560w, ${cld(MEDIA.headshot, 'w_900,c_fill,ar_4:5,g_face')} 900w`}
          sizes="(max-width: 820px) 90vw, 38vw"
          alt="Jason Foley, President of Premier Sales Group"
          width="720" height="900"
          loading="lazy"
        />
        <div class="about__plate">
          <span class="mono">Jason Foley</span>
          <span>President</span>
        </div>
      </div>

      <div class="about__body">
        <p class="eyebrow">About Jason</p>
        <h2 class="about__title">Wire is a family business. I grew up in it.</h2>
        <div class="about__copy">
          <p>
            I’m Jason Foley, and I founded Premier Sales Group to represent the kind of
            American manufacturers I know firsthand. My first line — <a href={unified.site} target="_blank" rel="noopener">Unified Wire &amp; Cable</a> —
            was built by my grandfather, uncle, and father. I’ve been around spools,
            specs, and shop floors my whole life.
          </p>
          <p>
            That background is the difference. When you call me, you’re not getting a
            middleman reading off a sheet — you’re getting someone who understands the
            product, respects the relationship, and answers the phone. I quote fast, I
            follow through, and I treat your business like it’s the only one that matters.
          </p>
          <p>
            Premier Sales Group is new on purpose. It’s built for how buyers actually
            work today: direct, responsive, and easy to deal with.
          </p>
        </div>
        <p class="about__slogan serif-accent">“{SITE.slogan}”</p>
        <div class="about__sign">
          <Signature />
          <a href={PERSON.linkedin} target="_blank" rel="noopener" class="link-arrow">
            Connect on LinkedIn
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ LINES ============================ -->
  <section class="section section--line" id="lines">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Lines I Represent</p>
        <h2>One line, chosen with intent — and room to grow.</h2>
        <p>
          A rep is only as good as the manufacturers behind them. I represent a focused,
          family-run American manufacturer I can stand behind completely.
        </p>
      </div>

      <article class="line reveal">
        <div class="line__head">
          <div>
            <h3 class="line__name">{unified.name}</h3>
            <a href={unified.site} target="_blank" rel="noopener" class="mono line__url">{unified.siteLabel} ↗</a>
          </div>
          <span class="tag">Active Line · 2026</span>
        </div>
        <p class="line__summary">{unified.summary}</p>

        <h4 class="line__sub">What Unified manufactures</h4>
        <ul class="line__grid">
          {unified.products.map((p) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {p}
            </li>
          ))}
        </ul>

        <div class="line__foot">
          <a href={unified.site} target="_blank" rel="noopener" class="btn btn--ghost">Visit Unified Wire &amp; Cable</a>
          <a href="#contact" class="link-arrow">
            Quote a Unified product
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </article>

      <p class="line__future mono reveal">
        ◇ Selectively adding complementary, non-competing lines — harnesses, connectors,
        and assemblies that go hand-in-hand with wire.
      </p>
    </div>
  </section>

  <!-- ============================ APPROACH ============================ -->
  <section class="section section--line" id="approach">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How I Work</p>
        <h2>What it’s like to work with me.</h2>
        <p>Four things you can count on from Premier Sales Group.</p>
      </div>
      <div class="approach">
        {APPROACH.map((a, i) => (
          <div class="card approach__card reveal">
            <span class="approach__num mono">0{i + 1}</span>
            <h3 class="approach__title">{a.title}</h3>
            <p class="approach__body">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ FAQ ============================ -->
  <section class="section section--line" id="faq">
    <div class="wrap faq">
      <div class="section-head reveal">
        <p class="eyebrow">Questions, Answered</p>
        <h2>What buyers ask before they call.</h2>
      </div>
      <div class="faq__list">
        {FAQS.map((f) => (
          <details class="faq__item reveal">
            <summary>
              <span>{f.q}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section class="section section--line" id="contact">
    <div class="wrap contact">
      <div class="contact__intro reveal">
        <p class="eyebrow">Start a Conversation</p>
        <h2 class="contact__title">Tell me what you’re buying. I’ll sharpen the pencil.</h2>
        <p class="contact__lede">
          Send the part numbers, specs, or just a photo of the spool you’re running today.
          You’ll get a clean, competitive quote back — usually within a day.
        </p>
        <ul class="contact__direct">
          <li>
            <span class="mono">Call</span>
            <a href={`tel:${PERSON.phone}`}>{PERSON.phoneDisplay}</a>
          </li>
          <li>
            <span class="mono">Email</span>
            <a href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
          </li>
          <li>
            <span class="mono">LinkedIn</span>
            <a href={PERSON.linkedin} target="_blank" rel="noopener">Jason Foley ↗</a>
          </li>
        </ul>
      </div>

      <form
        class="contact__form reveal"
        name="quote-request"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you"
      >
        <input type="hidden" name="form-name" value="quote-request" />
        <p class="hp" hidden>
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>

        <div class="field-row">
          <label class="field">
            <span>Name <em>*</em></span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="field">
            <span>Company</span>
            <input type="text" name="company" autocomplete="organization" />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>Email <em>*</em></span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label class="field">
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>
        </div>
        <label class="field">
          <span>What are you buying today?</span>
          <input type="text" name="product" placeholder="e.g. 12 AWG THHN, stranded, black — 50,000 ft / month" />
        </label>
        <label class="field">
          <span>Message <em>*</em></span>
          <textarea name="message" rows="4" required placeholder="Tell me about your build, volumes, or current supplier."></textarea>
        </label>
        <button type="submit" class="btn contact__submit">
          Send to Jason
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="contact__fine mono">Goes straight to Jason’s inbox. No lists, no spam.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; min-height: clamp(620px, 86vh, 900px); display: flex; align-items: center; overflow: hidden; }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 75% 50%; }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, var(--charcoal) 8%, rgba(22,22,24,0.82) 38%, rgba(22,22,24,0.25) 70%, transparent 100%),
      linear-gradient(0deg, var(--charcoal) 2%, transparent 28%);
  }
  .hero__inner { padding-block: clamp(5rem, 12vh, 8rem); }
  .hero__eyebrow { margin-bottom: 1.6rem; }
  .hero__title { font-size: var(--step-5); max-width: 17ch; font-weight: 400; }
  .hero__slogan { margin-top: 1.4rem; font-size: clamp(1.4rem, 3.2vw, 2.1rem); color: var(--copper-bright); line-height: 1.05; }
  .hero__lede { margin-top: 1rem; max-width: 46ch; font-size: var(--step-1); color: var(--text-dim); }
  .hero__lede strong { color: var(--bone); font-weight: 600; }
  .hero__ul { color: var(--copper-bright); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(200,119,46,0.5); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.4rem; }
  .hero__meta { margin-top: 2rem; color: var(--text-mute); }

  /* ---------- STATS ---------- */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border-inline: 1px solid var(--line); }
  .stat { background: var(--charcoal); padding: clamp(1.6rem, 3vw, 2.4rem) clamp(1rem, 2vw, 1.6rem); }
  .stat__n { display: block; font-family: var(--font-display); font-size: var(--step-3); color: var(--copper-bright); line-height: 1; }
  .stat__l { display: block; margin-top: 0.7rem; font-size: 0.9rem; color: var(--text-dim); }
  @media (max-width: 720px) { .stats { grid-template-columns: 1fr 1fr; } }

  /* ---------- ABOUT ---------- */
  .about { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .about__media { position: relative; }
  .about__media img { border-radius: var(--radius-lg); border: 1px solid var(--line); width: 100%; }
  .about__media::after {
    content: ''; position: absolute; inset: -1px;
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px rgba(200,119,46,0.18);
    pointer-events: none;
  }
  .about__plate {
    position: absolute; left: -12px; bottom: 22px;
    background: var(--copper); color: var(--ink);
    padding: 0.7rem 1.1rem; border-radius: var(--radius);
    display: flex; flex-direction: column; line-height: 1.1;
    box-shadow: 0 14px 30px -12px rgba(0,0,0,0.7);
  }
  .about__plate .mono { color: var(--ink); font-weight: 500; }
  .about__plate span:last-child { font-family: var(--font-grotesk); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.72rem; }
  .about__title { font-size: var(--step-3); margin: 0.7rem 0 1.4rem; max-width: 18ch; }
  .about__copy p { color: var(--text-dim); margin-bottom: 1rem; }
  .about__copy a { color: var(--copper-bright); text-decoration: underline; text-underline-offset: 2px; }
  .about__slogan { font-size: clamp(1.5rem, 3.5vw, 2.1rem); color: var(--copper-bright); margin-top: 1.8rem; line-height: 1.1; }
  .about__sign { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 1.2rem; }
  .about__sign .serif-accent { font-size: 1.7rem; color: var(--bone); }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .about__media { max-width: 380px; } }

  /* ---------- LINES ---------- */
  .line { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.6rem, 4vw, 3rem); background: linear-gradient(180deg, rgba(244,241,236,0.04), transparent); position: relative; overflow: hidden; }
  .line::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: linear-gradient(var(--copper), var(--copper-deep)); }
  .line__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .line__name { font-size: var(--step-2); }
  .line__url { display: inline-block; margin-top: 0.4rem; color: var(--copper-bright); }
  .line__summary { margin-top: 1.2rem; color: var(--text-dim); max-width: 64ch; font-size: var(--step-1); }
  .line__sub { font-family: var(--font-grotesk); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.78rem; color: var(--text-mute); margin: 2.2rem 0 1.1rem; }
  .line__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem 2rem; }
  .line__grid li { display: flex; align-items: center; gap: 0.7rem; color: var(--text); font-size: 0.98rem; }
  .line__grid svg { width: 1.1rem; height: 1.1rem; color: var(--copper-bright); flex: none; }
  .line__foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.2rem; margin-top: 2.4rem; }
  .line__future { margin-top: 1.6rem; color: var(--text-mute); }
  @media (max-width: 620px) { .line__grid { grid-template-columns: 1fr; } }

  /* ---------- APPROACH ---------- */
  .approach { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  .approach__num { color: var(--copper); font-size: 0.95rem; }
  .approach__title { font-size: var(--step-1); margin: 0.8rem 0 0.7rem; }
  .approach__body { color: var(--text-dim); }
  @media (max-width: 700px) { .approach { grid-template-columns: 1fr; } }

  /* ---------- FAQ ---------- */
  .faq { max-width: 880px; }
  .faq__list { display: flex; flex-direction: column; }
  .faq__item { border-top: 1px solid var(--line); }
  .faq__item:last-child { border-bottom: 1px solid var(--line); }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.4rem 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: var(--step-1); color: var(--bone);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item svg { width: 1.3rem; height: 1.3rem; color: var(--copper-bright); flex: none; transition: transform 0.3s var(--ease); }
  .faq__item[open] svg { transform: rotate(45deg); }
  .faq__item p { color: var(--text-dim); padding-bottom: 1.4rem; max-width: 70ch; }

  /* ---------- CONTACT ---------- */
  .contact { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact__title { font-size: var(--step-3); margin: 0.7rem 0 1.2rem; }
  .contact__lede { color: var(--text-dim); font-size: var(--step-1); max-width: 42ch; }
  .contact__direct { margin-top: 2rem; display: flex; flex-direction: column; gap: 1rem; }
  .contact__direct li { display: grid; grid-template-columns: 5rem 1fr; align-items: baseline; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .contact__direct a { color: var(--bone); font-size: 1.1rem; transition: color 0.2s var(--ease); }
  .contact__direct a:hover { color: var(--copper-bright); }

  .contact__form { background: var(--charcoal-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.4rem, 3vw, 2.2rem); }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { display: block; margin-bottom: 1rem; }
  .field > span { display: block; font-family: var(--font-grotesk); font-weight: 600; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.5rem; }
  .field em { color: var(--copper-bright); font-style: normal; }
  .field input, .field textarea {
    width: 100%; font: inherit; font-size: 0.98rem; color: var(--bone);
    background: var(--ink); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 0.8rem 0.9rem; transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field input::placeholder, .field textarea::placeholder { color: var(--text-mute); }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--copper); box-shadow: 0 0 0 3px rgba(200,119,46,0.15); }
  .contact__submit { width: 100%; justify-content: center; margin-top: 0.6rem; }
  .contact__fine { text-align: center; margin-top: 1rem; color: var(--text-mute); }
  .hp { position: absolute; left: -9999px; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 460px) { .field-row { grid-template-columns: 1fr; } }
</style>
