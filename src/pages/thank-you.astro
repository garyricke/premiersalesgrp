---
import Base from '../layouts/Base.astro';
import { PERSON } from '../consts';
---

<Base
  title="Thank You"
  description="Your message has been sent to Jason Foley at Premier Sales Group."
  path="/thank-you"
  noindex={true}
>
  <section class="ty">
    <div class="wrap ty__inner">
      <svg class="ty__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M8 12.5l2.5 2.5L16 9" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <p class="eyebrow center">Message Received</p>
      <h1>Thanks — it’s in Jason’s inbox.</h1>
      <p class="ty__lede">
        I’ll review what you sent and get back to you personally, usually within one
        business day. If it’s time-sensitive, call me directly.
      </p>
      <div class="ty__cta">
        <a href={`tel:${PERSON.phone}`} class="btn">Call {PERSON.phoneDisplay}</a>
        <a href="/" class="btn btn--ghost">Back to Home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ty { min-height: 70vh; display: grid; place-items: center; text-align: center; }
  .ty__inner { max-width: 56ch; }
  .ty__check { width: 4rem; height: 4rem; color: var(--copper-bright); margin: 0 auto 1.6rem; }
  .ty h1 { font-size: var(--step-4); margin: 0.8rem 0 1.2rem; }
  .ty__lede { color: var(--text-dim); font-size: var(--step-1); }
  .ty__cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2.2rem; }
</style>
