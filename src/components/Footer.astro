---
import Logo from './Logo.astro';
import { NAV, FOOTER_NAV, PERSON, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo />
        <p class="ftr__tag">{SITE.tagline}</p>
        <a href="https://unifiedwire.com" target="_blank" rel="noopener" class="mono ftr__line">
          Proudly representing Unified Wire &amp; Cable ↗
        </a>
      </div>

      <div class="ftr__cols">
        <div>
          <h3 class="ftr__h">Navigate</h3>
          <ul>
            {NAV.map((i) => (<li><a href={i.href}>{i.label}</a></li>))}
          </ul>
        </div>
        <div>
          <h3 class="ftr__h">Brand &amp; Process</h3>
          <ul>
            {FOOTER_NAV.map((i) => (<li><a href={i.href}>{i.label}</a></li>))}
          </ul>
        </div>
        <div>
          <h3 class="ftr__h">Contact</h3>
          <ul>
            <li><a href={`tel:${PERSON.phone}`}>{PERSON.phoneDisplay}</a></li>
            <li><a href={`mailto:${PERSON.email}`}>{PERSON.email}</a></li>
            <li><a href={PERSON.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="ftr__bottom">
      <p class="mono">© {year} {SITE.legalName}. All rights reserved.</p>
      <p class="mono">{PERSON.name}, {PERSON.role} · {SITE.domain}</p>
    </div>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--line); padding-block: clamp(3rem, 6vw, 5rem) 2rem; background: var(--ink); }
  .ftr__top { display: grid; grid-template-columns: 1.2fr 2fr; gap: clamp(2rem, 5vw, 4rem); }
  .ftr__tag { color: var(--text-dim); max-width: 34ch; margin-top: 1.2rem; font-size: 1.02rem; }
  .ftr__line { display: inline-block; margin-top: 1.2rem; color: var(--copper-bright); }
  .ftr__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .ftr__h {
    font-family: var(--font-grotesk);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 1rem;
  }
  .ftr__cols ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .ftr__cols a { color: var(--text-dim); transition: color 0.2s var(--ease); font-size: 0.95rem; }
  .ftr__cols a:hover { color: var(--copper-bright); }
  .ftr__bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.6rem;
    margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: 1.6rem; border-top: 1px solid var(--line);
  }
  @media (max-width: 820px) {
    .ftr__top { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; }
  }
</style>
